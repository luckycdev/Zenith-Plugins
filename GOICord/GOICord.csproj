<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- class libraries don't copy NuGet package dlls to the output by default; ILRepack needs them there -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

<ItemGroup>
  <PackageReference Include="Discord.Net" Version="3.17.4" />
  <PackageReference Include="Discord.Net.Core" Version="3.17.4" />
  <PackageReference Include="Discord.Net.Rest" Version="3.17.4" />
  <PackageReference Include="Discord.Net.WebSocket" Version="3.17.4" />

  <PackageReference Include="System.Collections.Immutable" Version="8.0.0" />

  <!-- Merges the Discord.Net dlls into GOICord.dll after every build (see ILRepack.targets) -->
  <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34.2">
    <PrivateAssets>all</PrivateAssets>
  </PackageReference>
</ItemGroup>

  <ItemGroup>
    <Reference Include="Lidgren.Network">
      <HintPath>..\..\Zenith\Zenith\GettingOverItMP.Server\bin\Debug\net5.0\Lidgren.Network.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="ServerShared">
      <HintPath>..\..\Zenith\Zenith\GettingOverItMP.Server\bin\Debug\net5.0\ServerShared.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\Zenith\Zenith\GettingOverItMP.Server\bin\Debug\net5.0\UnityEngine.CoreModule.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

</Project>